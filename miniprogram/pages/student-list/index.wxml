<view class="page page--no-tab">
  <view wx:if="{{loading && !students.length}}" class="empty">加载中…</view>

  <view wx:elif="{{!students.length}}" class="empty">
    <text class="empty__title">暂无学员</text>
    <text class="empty__desc">新增后可维护头像与备注</text>
    <view class="soft-btn soft-btn--primary empty__btn" bindtap="onAdd">新增学员</view>
  </view>

  <block wx:else>
    <view
      wx:for="{{students}}"
      wx:key="name"
      class="row surface-card"
      data-name="{{item.name}}"
      bindtap="onOpen"
    >
      <image
        wx:if="{{item.avatarUrl}}"
        class="row__avatar"
        src="{{item.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="row__avatar row__avatar--text">{{item.initial}}</view>
      <view class="row__body">
        <text class="row__name">{{item.name}}</text>
        <text wx:if="{{item.note}}" class="row__meta">{{item.note}}</text>
        <text wx:else class="row__meta">暂无备注</text>
      </view>
      <text class="row__chev">›</text>
    </view>
  </block>

  <view wx:if="{{students.length}}" class="fab-space"></view>
  <view wx:if="{{students.length}}" class="fab" bindtap="onAdd">＋ 新增学员</view>
</view>
