.ov-list__period {
  margin: 0 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.ov-list__chips {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.ov-list__chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.ov-list__chip.is-active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.ov-list__row,
.ov-list__teacher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}

.ov-list__main {
  min-width: 0;
  flex: 1;
}

.ov-list__line1 {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ov-list__date {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.ov-list__time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.ov-list__line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ov-list__right {
  flex-shrink: 0;
}

.ov-list__amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.ov-list__badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.ov-list__badge.is-done {
  background: rgba(82, 168, 120, 0.14);
  color: #438a62;
}

.ov-list__badge.is-pending {
  background: rgba(59, 130, 246, 0.14);
  color: #2563eb;
}

.ov-list__badge.is-closed {
  background: rgba(154, 161, 170, 0.18);
  color: #7b8490;
}

.ov-list__teacher-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.ov-list__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f0ff;
  color: #7c4ddb;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ov-list__teacher-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.ov-list__teacher-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}
