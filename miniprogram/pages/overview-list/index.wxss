.ov-list__period {
  margin: 0 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.ov-list__chips {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.ov-list__chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.ov-list__chip.is-active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.ov-list__row,
.ov-list__teacher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}

.ov-list__main {
  min-width: 0;
  flex: 1;
}

.ov-list__line1 {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ov-list__date {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.ov-list__time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.ov-list__line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ov-list__right {
  flex-shrink: 0;
}

.ov-list__amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.ov-list__badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.ov-list__badge.is-done {
  background: rgba(82, 168, 120, 0.14);
  color: #438a62;
}

.ov-list__badge.is-pending {
  background: rgba(59, 130, 246, 0.14);
  color: #2563eb;
}

.ov-list__badge.is-closed {
  background: rgba(154, 161, 170, 0.18);
  color: #7b8490;
}

.ov-list__badge.is-missed {
  background: rgba(245, 158, 11, 0.16);
  color: #b45309;
}

.ov-list__teacher-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.ov-list__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f0ff;
  color: #7c4ddb;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ov-list__teacher-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.ov-list__teacher-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.ov-list__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 8rpx 20rpx;
}

.ov-list__hint {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-muted);
}

.ov-list__actions {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
}

.ov-list__btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: var(--shadow-card);
}

.ov-list__btn--muted {
  color: var(--color-muted);
}

.ov-list__row.is-selecting {
  padding-left: 24rpx;
}

.ov-list__row.is-picked {
  box-shadow: inset 0 0 0 3rpx rgba(59, 130, 246, 0.28);
}

.ov-list__check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #c5ccd6;
  background: #fff;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ov-list__check.is-on {
  border-color: #3b82f6;
  background: #3b82f6;
}

.ov-delbar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 20;
}

.ov-delbar__btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(239, 68, 68, 0.32);
}

.ov-delbar__btn.is-disabled {
  background: #c5ccd6;
  box-shadow: none;
}

.page.is-selecting {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
