.overview {
  --ov-ink: #1f2937;
  --ov-muted: #9aa3af;
  --ov-line: #e8ecf2;
  --ov-blue: #4f8cff;
  --ov-blue-deep: #3b82f6;
  --ov-green: #52a878;
  --ov-purple: #8b5cf6;
  background: #f4f6fa;
  padding-left: 28rpx;
  padding-right: 28rpx;
  min-height: 100vh;
}

/* —— Brand —— */
.ov-brand {
  position: relative;
  min-height: 120rpx;
  margin-bottom: 8rpx;
  padding-right: 220rpx;
}

.ov-brand__left {
  position: relative;
  display: inline-block;
  padding-top: 8rpx;
  max-width: 100%;
}

.ov-brand__stars {
  position: absolute;
  top: -8rpx;
  left: 8rpx;
  color: #f5c542;
  font-size: 22rpx;
  line-height: 1;
  transform: rotate(-12deg);
}

.ov-brand__title-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  max-width: 100%;
}

.ov-brand__title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ov-ink);
  letter-spacing: 0.02em;
  line-height: 1.2;
}

.ov-brand__sep {
  font-size: 22rpx;
  color: #c5cdd8;
  line-height: 1.2;
}

.ov-brand__student {
  font-size: 22rpx;
  font-weight: 400;
  color: #8b95a5;
  line-height: 1.2;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ov-brand__underline {
  margin-top: 6rpx;
  width: 72rpx;
  height: 10rpx;
  margin-left: 88rpx;
  background: #f5c542;
  border-radius: 999rpx;
  transform: rotate(-2deg);
  opacity: 0.95;
}

.ov-brand__hero {
  position: absolute;
  right: -12rpx;
  top: -28rpx;
  width: 260rpx;
  height: 190rpx;
  pointer-events: none;
}

/* —— Period —— */
.ov-period {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}

.ov-period__left {
  flex: 1;
  min-width: 0;
}

.ov-period__date {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.ov-period__label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ov-ink);
}

.ov-period__caret {
  font-size: 22rpx;
  color: var(--ov-muted);
  margin-top: 4rpx;
}

.ov-period__wave {
  width: 120rpx;
  height: 8rpx;
  margin: 6rpx 0 18rpx;
  background: linear-gradient(90deg, #9ec5ff, #c7ddff);
  border-radius: 999rpx;
  opacity: 0.7;
}

.ov-chips {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.ov-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #e8ecf2;
  box-shadow: 0 4rpx 12rpx rgba(27, 36, 48, 0.04);
  transition: transform 140ms ease, box-shadow 140ms ease;
}

.ov-chip.is-active {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(90deg, #5b9cff 0%, #6e8bff 100%);
  box-shadow: 0 8rpx 20rpx rgba(79, 140, 255, 0.35);
  transform: scale(1.03);
}

.ov-period__right {
  padding-top: 4rpx;
  flex-shrink: 0;
}

.ov-pick {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e8ecf2;
  box-shadow: 0 4rpx 14rpx rgba(27, 36, 48, 0.05);
}

.ov-pick.is-active {
  border-color: #bfdbfe;
  background: #eff6ff;
}

.ov-pick__ico {
  font-size: 24rpx;
  line-height: 1;
}

.ov-pick__text {
  font-size: 22rpx;
  font-weight: 600;
  color: #4b5563;
}

.ov-custom {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(27, 36, 48, 0.06);
}

.ov-custom__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.ov-custom__label {
  font-size: 26rpx;
  color: var(--ov-muted);
}

.ov-custom__value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ov-ink);
}

.ov-custom__apply {
  margin-top: 8rpx;
  text-align: center;
  padding: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5b9cff, #6e8bff);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* —— Cards —— */
.ov-card {
  position: relative;
  border-radius: 32rpx;
  padding: 28rpx 28rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 32rpx rgba(27, 36, 48, 0.05);
  overflow: visible;
}

.ov-card--course {
  background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 55%);
  overflow: hidden;
}

.ov-card--expense {
  background: linear-gradient(180deg, #fff6eb 0%, #fffaf4 100%);
  padding-bottom: 32rpx;
  overflow: hidden;
}

.ov-card--teacher {
  background: #ffffff;
}

.ov-card__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.ov-card__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ov-card__icon--book {
  background: linear-gradient(145deg, #6aa8ff, #4f8cff);
}

.ov-card__icon--wallet {
  background: linear-gradient(145deg, #ffb36b, #f59e0b);
}

.ov-ico-book {
  width: 22rpx;
  height: 18rpx;
  border: 3rpx solid #fff;
  border-radius: 3rpx 3rpx 2rpx 2rpx;
  position: relative;
}

.ov-ico-book::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: #fff;
  transform: translateX(-50%);
}

.ov-ico-wallet {
  width: 22rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  position: relative;
}

.ov-ico-wallet::after {
  content: '';
  position: absolute;
  right: -2rpx;
  top: 3rpx;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: transparent;
}

.ov-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ov-ink);
}

/* course body */
.ov-course-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 8rpx 8rpx;
}

.ov-course-main {
  flex: 1;
  min-width: 0;
}

.ov-course-hero {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.ov-course-num {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--ov-ink);
}

.ov-course-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: #6b7280;
}

.ov-trend {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #ef6b6b;
}

.ov-trend.is-up {
  color: #ef6b6b;
}

.ov-trend:not(.is-up):not(.is-flat) {
  color: #52a878;
}

.ov-trend.is-flat {
  color: var(--ov-muted);
}

.ov-trend__arrow {
  font-size: 18rpx;
  line-height: 1;
}

.ov-trend__text {
  font-size: 22rpx;
  font-weight: 600;
}

.ov-donut-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.ov-donut {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 140, 255, 0.12);
}

.ov-donut__hole {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(232, 236, 242, 0.8);
}

.ov-donut-arrow {
  position: absolute;
  left: -28rpx;
  top: 56rpx;
  color: #7cb0ff;
  font-size: 36rpx;
  transform: rotate(20deg);
  opacity: 0.85;
  line-height: 1;
}

/* status footer：每项图标左 + 文案右 */
.ov-status {
  margin-top: 20rpx;
  padding-top: 24rpx;
  padding-bottom: 4rpx;
  border-top: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
}

.ov-status__item {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-width: 0;
}

.ov-status__divider {
  width: 1rpx;
  align-self: stretch;
  background: #e8ecf2;
  margin: 4rpx 0;
  flex-shrink: 0;
}

.ov-status__badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ov-status__badge--done {
  background: #52a878;
}

.ov-status__badge--pending {
  background: #3b82f6;
}

.ov-status__badge--closed {
  background: #9aa1aa;
}

.ov-status__texts {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  min-width: 0;
}

.ov-status__n {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ov-ink);
  line-height: 1.2;
  white-space: nowrap;
}

.ov-status__t {
  font-size: 22rpx;
  color: var(--ov-muted);
  line-height: 1.2;
  white-space: nowrap;
}

/* expense */
.ov-expense-pig {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  width: 120rpx;
  height: 100rpx;
  z-index: 1;
  pointer-events: none;
}

.ov-expense-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding-right: 100rpx;
  position: relative;
  z-index: 2;
}

.ov-expense-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
  border-right: 2rpx dashed #ead9c4;
}

.ov-expense-money-wrap {
  position: relative;
  display: inline-block;
}

.ov-expense-money {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--ov-ink);
}

.ov-expense-underline {
  position: absolute;
  left: 28rpx;
  right: 0;
  bottom: 2rpx;
  height: 12rpx;
  background: #f5c542;
  border-radius: 999rpx;
  opacity: 0.85;
  transform: rotate(-1.5deg);
  z-index: -1;
}

.ov-expense-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #a08970;
}

.ov-expense-avg {
  flex-shrink: 0;
  padding: 0 8rpx 4rpx 16rpx;
  text-align: left;
}

.ov-expense-avg__n {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ov-ink);
  line-height: 1.2;
}

.ov-expense-avg__row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ov-expense-avg__t {
  font-size: 20rpx;
  color: #a08970;
}

.ov-expense-avg__i {
  font-size: 20rpx;
  color: #c4b5a0;
  line-height: 1;
}

/* teachers */
.ov-teacher-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ov-teacher-head__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ov-ink);
}

.ov-teacher-head__more {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7280;
}

.ov-teacher {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.ov-teacher:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.ov-teacher__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.ov-teacher__avatar.tone-purple {
  background: #efe8ff;
  color: #7c4ddb;
}

.ov-teacher__avatar.tone-blue {
  background: #e8f1ff;
  color: #3b82f6;
}

.ov-teacher__avatar.tone-green {
  background: #e7f6ee;
  color: #3d9a6a;
}

.ov-teacher__img {
  width: 100%;
  height: 100%;
}

.ov-teacher__info {
  flex-shrink: 0;
  min-width: 96rpx;
  max-width: 140rpx;
}

.ov-teacher__name-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ov-teacher__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ov-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 110rpx;
}

.ov-teacher__star {
  font-size: 18rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ov-teacher__star.tone-purple {
  color: #8b5cf6;
}

.ov-teacher__star.tone-blue {
  color: #3b82f6;
}

.ov-teacher__star.tone-green {
  color: #52a878;
}

.ov-teacher__lessons {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ov-muted);
}

.ov-teacher__bar-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx;
}

.ov-teacher__bar {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f1f3f6;
  overflow: hidden;
}

.ov-teacher__bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.ov-teacher__bar-fill.tone-purple {
  background: linear-gradient(90deg, #a78bfa, #8b5cf6);
}

.ov-teacher__bar-fill.tone-blue {
  background: linear-gradient(90deg, #60a5fa, #3b82f6);
}

.ov-teacher__bar-fill.tone-green {
  background: linear-gradient(90deg, #6ee7b7, #34d399);
}

.ov-teacher__pct {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ov-muted);
  width: 56rpx;
  text-align: right;
  flex-shrink: 0;
}

.ov-teacher__right {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
}

.ov-teacher__amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ov-ink);
  white-space: nowrap;
}

.ov-teacher__chev {
  font-size: 28rpx;
  color: #c0c6d0;
  font-weight: 400;
}

.ov-empty-inline {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(27, 36, 48, 0.4);
  padding-bottom: 12rpx;
}

.ov-hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ov-muted);
}
