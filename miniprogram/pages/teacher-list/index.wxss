.page--no-tab {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.empty {
  margin-top: 120rpx;
  padding: 40rpx;
  text-align: center;
  color: #9aa3b2;
}

.empty__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2332;
  margin-bottom: 12rpx;
}

.empty__desc {
  display: block;
  font-size: 26rpx;
  margin-bottom: 40rpx;
}

.empty__btn {
  display: inline-block;
  min-width: 280rpx;
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
}

.row:active {
  opacity: 0.92;
}

.row__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e8eef6;
}

.row__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #3b82f6;
}

.row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.row__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2332;
}

.row__meta {
  font-size: 24rpx;
  color: #9aa3b2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__chev {
  color: #c5ccd6;
  font-size: 32rpx;
}

.fab-space {
  height: 120rpx;
}

.fab {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #6aa4ff 0%, #3b82f6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(59, 130, 246, 0.28);
}

.soft-btn {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
}

.soft-btn--primary {
  background: linear-gradient(180deg, #6aa4ff 0%, #3b82f6 100%);
  color: #fff;
}
