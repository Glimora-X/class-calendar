.section {
  margin-bottom: 24rpx;
}

.soft-block {
  padding: 28rpx;
}

.section__title {
  font-size: 22rpx;
  color: #8b95a5;
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 0.06em;
}

.ph {
  color: #b0b8c4;
}

.soft-textarea {
  width: 100%;
  min-height: 148rpx;
  background: #eef2f7;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #1b2430;
  line-height: 1.5;
}

.form {
  padding: 8rpx 8rpx 8rpx 28rpx;
}

.soft-field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding-right: 20rpx;
  border-bottom: 1rpx solid #e6ebf2;
}

.soft-field--last {
  border-bottom: none;
}

.soft-field--tappable:active {
  background: rgba(59, 130, 246, 0.04);
}

.soft-field__label {
  width: 120rpx;
  flex-shrink: 0;
  color: #8b95a5;
  font-size: 26rpx;
  font-weight: 600;
}

.soft-field__input {
  flex: 1;
  font-size: 30rpx;
  color: #1b2430;
  font-weight: 500;
}

.soft-field__value {
  flex: 1;
  font-size: 30rpx;
  color: #1b2430;
  font-weight: 600;
}

.soft-field__chev {
  color: #c5ccd6;
  font-size: 36rpx;
  padding: 0 8rpx;
}

.soft-btn {
  margin: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 40rpx;
}

.soft-btn::after {
  border: none;
}

.soft-btn--primary {
  background: linear-gradient(180deg, #60a5fa 0%, #3b82f6 100%);
  color: #fff;
  box-shadow: 0 16rpx 36rpx rgba(59, 130, 246, 0.35);
}

.soft-btn--ghost {
  display: inline-block;
  height: 72rpx;
  line-height: 72rpx;
  background: #fff;
  color: #3b82f6;
  border: 2rpx solid rgba(59, 130, 246, 0.35);
  font-size: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(27, 36, 48, 0.04);
}

.soft-btn--danger {
  margin-top: 20rpx;
  background: #fff;
  color: #ef4444;
  box-shadow: 0 8rpx 24rpx rgba(27, 36, 48, 0.06);
}

.save {
  margin-top: 12rpx;
  width: 100%;
}
