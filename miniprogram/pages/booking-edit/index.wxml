<view class="page page--no-tab">
  <view wx:if="{{showSubscribeGate}}" class="subscribe-gate surface-card soft-block">
    <view class="subscribe-gate__title">已保存</view>
    <view class="subscribe-gate__desc">请点击下方按钮，在微信弹窗里允许「日程提醒」（不要连点太快）。</view>
    <view
      class="soft-btn soft-btn--primary subscribe-gate__btn {{subscribeBusy ? 'is-disabled' : ''}}"
      bindtap="onSubscribeTap"
    >
      {{subscribeBusy ? '请完成微信弹窗…' : '授权微信提醒'}}
    </view>
    <view class="soft-btn soft-btn--ghost subscribe-gate__skip" bindtap="onSkipSubscribe">
      暂时不用
    </view>
  </view>

  <view wx:if="{{!_id && !showSubscribeGate}}" class="section surface-card soft-block">
    <view class="section__title">快捷解析</view>
    <textarea
      class="soft-textarea"
      placeholder="例：小明 王老师 4.15 19:30-19:55 英语"
      placeholder-class="ph"
      value="{{quickText}}"
      bindinput="onQuickInput"
      maxlength="200"
    />
    <button class="soft-btn soft-btn--ghost" bindtap="onParseQuick">解析填充</button>
  </view>

  <view class="section">
    <subject-picker
      subjects="{{subjects}}"
      value="{{subjectId}}"
      bind:change="onSubjectChange"
      bind:add="onSubjectAdd"
    />
  </view>

  <view class="section surface-card soft-block form">
    <name-suggest
      label="学员"
      placeholder="必填"
      value="{{studentName}}"
      suggestions="{{studentSuggestions}}"
      bind:input="onStudentSuggest"
    />
    <name-suggest
      label="老师"
      placeholder="必填"
      value="{{teacherName}}"
      suggestions="{{teacherSuggestions}}"
      bind:input="onTeacherSuggest"
    />

    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="soft-field soft-field--tappable">
        <text class="soft-field__label">日期</text>
        <text class="soft-field__value">{{date}}</text>
        <text class="soft-field__chev">›</text>
      </view>
    </picker>

    <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
      <view class="soft-field soft-field--tappable">
        <text class="soft-field__label">开始</text>
        <text class="soft-field__value">{{startTime}}</text>
        <text class="soft-field__chev">›</text>
      </view>
    </picker>

    <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
      <view class="soft-field soft-field--tappable">
        <text class="soft-field__label">结束</text>
        <text class="soft-field__value">{{endTime}}</text>
        <text class="soft-field__chev">›</text>
      </view>
    </picker>

    <picker
      mode="selector"
      range="{{statusOptions}}"
      range-key="label"
      value="{{statusIndex}}"
      bindchange="onStatusChange"
    >
      <view class="soft-field soft-field--tappable">
        <text class="soft-field__label">状态</text>
        <text class="soft-field__value">{{statusDisplay}}</text>
        <text class="soft-field__chev">›</text>
      </view>
    </picker>

    <view class="soft-field soft-field--last">
      <text class="soft-field__label">备注</text>
      <input
        class="soft-field__input"
        data-field="note"
        value="{{note}}"
        bindinput="onFieldInput"
        placeholder="可选"
        placeholder-class="ph"
      />
    </view>
  </view>

  <view wx:if="{{!showSubscribeGate}}" class="actions {{_id ? 'actions--split' : ''}}">
    <button
      wx:if="{{_id}}"
      class="soft-btn soft-btn--danger actions__btn"
      bindtap="onDelete"
    >
      删除
    </button>
    <button
      class="soft-btn soft-btn--primary actions__btn actions__btn--save"
      loading="{{saving}}"
      bindtap="onSave"
    >
      保存约课
    </button>
  </view>
</view>
