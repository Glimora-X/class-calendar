.head {
  margin-bottom: 24rpx;
}

.soft-block {
  padding: 28rpx;
}

.head__title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1b2430;
}

.head__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b95a5;
}

.section {
  margin-bottom: 24rpx;
}

.section__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8b95a5;
}

.link {
  font-size: 24rpx;
  color: #3b82f6;
  font-weight: 600;
}

.row {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.row--skip {
  opacity: 0.9;
}

.row.is-on .check {
  background: #3b82f6;
  color: #fff;
  border-color: #3b82f6;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #c5ccd6;
  margin-top: 6rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.row__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b2430;
}

.row__meta {
  font-size: 22rpx;
  color: #8b95a5;
}

.row__warn {
  font-size: 22rpx;
  color: #ef4444;
}

.hint {
  padding: 24rpx 8rpx;
  font-size: 26rpx;
  color: #8b95a5;
  text-align: center;
}

.soft-btn {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.soft-btn::after {
  border: none;
}

.soft-btn--primary {
  background: #3b82f6;
  color: #fff;
  box-shadow: 0 16rpx 36rpx rgba(59, 130, 246, 0.35);
}

.soft-btn[disabled] {
  opacity: 0.45;
}
