<view class="page page--no-tab ov-list {{selecting ? 'is-selecting' : ''}}">
  <view wx:if="{{periodLabel}}" class="ov-list__period">{{periodLabel}}</view>

  <view wx:if="{{chips.length}}" class="ov-list__chips">
    <view
      wx:for="{{chips}}"
      wx:key="id"
      class="ov-list__chip {{item.active ? 'is-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onChip"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{canManage}}" class="ov-list__toolbar">
    <text class="ov-list__hint">
      {{selecting ? (selectedCount ? '已选 ' + selectedCount + ' 节' : '点课程勾选') : '点管理可勾选删除'}}
    </text>
    <view wx:if="{{!selecting}}" class="ov-list__actions">
      <view class="ov-list__btn" bindtap="onEnterSelect">管理</view>
    </view>
    <view wx:else class="ov-list__actions">
      <view class="ov-list__btn" bindtap="onSelectAllRows">全选</view>
      <view class="ov-list__btn ov-list__btn--muted" bindtap="onCancelSelect">取消</view>
    </view>
  </view>

  <block wx:if="{{mode === 'teachers'}}">
    <view
      wx:for="{{teachers}}"
      wx:key="name"
      class="ov-list__teacher surface-card"
      data-name="{{item.name}}"
      bindtap="onTapTeacher"
    >
      <view class="ov-list__teacher-left">
        <view class="ov-list__avatar">{{item.initial}}</view>
        <view>
          <text class="ov-list__teacher-name">{{item.name}}</text>
          <text class="ov-list__teacher-sub">{{item.lessonCount}}节</text>
        </view>
      </view>
      <text class="ov-list__amount">{{item.amountLabel}}</text>
    </view>
  </block>

  <block wx:else>
    <view
      wx:for="{{rows}}"
      wx:key="_id"
      class="ov-list__row surface-card {{selecting ? 'is-selecting' : ''}} {{selectedMap[item._id] ? 'is-picked' : ''}}"
      data-id="{{item._id}}"
      bindtap="onTapRow"
    >
      <view wx:if="{{selecting}}" class="ov-list__check {{selectedMap[item._id] ? 'is-on' : ''}}">{{selectedMap[item._id] ? '✓' : ''}}</view>
      <view class="ov-list__main">
        <view class="ov-list__line1">
          <text class="ov-list__date">{{item.dateLabel}} {{item.weekday}}</text>
          <text wx:if="{{item.time}}" class="ov-list__time">{{item.time}}</text>
        </view>
        <view class="ov-list__line2">
          <text wx:if="{{mode === 'expense'}}">{{item.teacherName}}</text>
          <text wx:elif="{{mode === 'teacher'}}">{{item.studentName}} · {{item.subjectName}}</text>
          <text wx:else>{{item.teacherName}} · {{item.studentName}}</text>
        </view>
      </view>
      <view class="ov-list__right">
        <text wx:if="{{item.amountLabel}}" class="ov-list__amount">{{item.amountLabel}}</text>
        <text wx:else class="ov-list__badge {{item.statusClass}}">{{item.statusLabel}}</text>
      </view>
    </view>
  </block>

  <empty-state wx:if="{{empty && !loading}}" text="这里空空的" hint="换个时间再看看？" />

  <view wx:if="{{selecting}}" class="ov-delbar">
    <view
      class="ov-delbar__btn {{selectedCount ? '' : 'is-disabled'}}"
      bindtap="onConfirmBatchDelete"
    >删除 {{selectedCount}} 节</view>
  </view>
</view>
