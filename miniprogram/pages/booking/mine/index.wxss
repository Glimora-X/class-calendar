.mine {
  padding-top: 8rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
}

.profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #dbeafe;
  color: #2563eb;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1b2430;
  line-height: 1.2;
}

.profile__sub {
  font-size: 24rpx;
  color: #8b95a5;
  line-height: 1.3;
}

.profile__chev {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #c0c7d1;
  line-height: 1;
}

.section-label {
  margin: 8rpx 12rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8b95a5;
  letter-spacing: 0.04em;
}

.menu {
  overflow: hidden;
  margin-bottom: 28rpx;
}

.menu--solo {
  margin-top: 8rpx;
}

.menu__item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.menu__item--last,
.menu__item:last-child {
  border-bottom: none;
}

.menu__item--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.menu__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.menu__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b2430;
  line-height: 1.3;
}

.menu__desc {
  font-size: 22rpx;
  color: #8b95a5;
  line-height: 1.35;
}

.menu__aside {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.menu__value {
  font-size: 26rpx;
  font-weight: 500;
  color: #8b95a5;
}

.menu__value--danger {
  color: #ef4444;
}

.menu__chev {
  font-size: 32rpx;
  color: #c0c7d1;
  line-height: 1;
}

.menu__chev--danger {
  color: #fca5a5;
}

.menu__item--danger .menu__title {
  color: #ef4444;
}

.version {
  margin: 16rpx 0 24rpx;
  text-align: center;
  color: #8b95a5;
  font-size: 22rpx;
}
