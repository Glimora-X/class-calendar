.section-label {
  margin: 8rpx 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8b95a5;
  letter-spacing: 0.06em;
}

.menu {
  overflow: hidden;
  margin-bottom: 12rpx;
}

.menu__item {
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid #e6ebf2;
  font-size: 30rpx;
  font-weight: 600;
}

.menu__item--last,
.menu__item:last-child {
  border-bottom: none;
}

.menu__item--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.menu__value {
  font-size: 26rpx;
  font-weight: 600;
  color: #8b95a5;
  flex-shrink: 0;
}

.menu__item--danger {
  color: #ef4444;
}

.hint {
  margin: 8rpx 12rpx 36rpx;
  font-size: 22rpx;
  color: #b0b8c4;
  line-height: 1.5;
}

.version {
  margin-top: 48rpx;
  text-align: center;
  color: #8b95a5;
  font-size: 22rpx;
}
