<view class="page {{selecting && mode !== 'calendar' ? 'is-selecting' : ''}}">
  <month-nav
    year="{{year}}"
    month="{{month}}"
    mode="{{mode}}"
    showStudentCycle="{{showStudentCycle}}"
    studentLabel="{{studentLabel}}"
    bind:change="onMonthChange"
    bind:modechange="onModeChange"
    bind:studentcycle="onStudentCycle"
  />

  <filter-chips items="{{chips}}" bind:change="onFilterChange" />

  <view class="cal-stage {{stageClass}}">
    <block wx:if="{{mode === 'calendar'}}">
      <calendar-grid
        year="{{year}}"
        month="{{month}}"
        selectedDate="{{selectedDate}}"
        marks="{{marks}}"
        holidays="{{holidays}}"
        holds="{{holdMap}}"
        legend="{{legend}}"
        bind:select="onSelectDate"
      />

      <view class="section-head">
        <text class="section-title">{{selectedLabel}}</text>
        <view class="section-actions">
          <view
            wx:if="{{!selectedHoldReason}}"
            class="section-btn"
            bindtap="onTapMarkHold"
          >
            <view class="section-btn__ico section-btn__ico--hold">
              <view class="ico-hold"></view>
            </view>
          </view>
          <view class="section-btn" bindtap="onTapBatch">
            <view class="section-btn__ico section-btn__ico--batch">
              <view class="ico-batch"></view>
            </view>
          </view>
          <view class="section-btn" bindtap="onTapBatchDelete">
            <view class="section-btn__ico section-btn__ico--del">
              <view class="ico-del"></view>
            </view>
          </view>
          <view class="section-btn" bindtap="onTapCopyMonth">
            <view class="section-btn__ico section-btn__ico--copy">
              <view class="ico-copy"></view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{selectedHoldReason && !showHoldEditor}}" class="hold-banner">
        <view class="hold-banner__main">
          <text class="hold-banner__title">这天有其他安排</text>
          <text class="hold-banner__reason">{{selectedHoldReason}}</text>
          <text class="hold-banner__hint">最好别再约</text>
        </view>
        <view class="hold-banner__actions">
          <text class="hold-banner__link" bindtap="onTapEditHold">改事由</text>
          <text class="hold-banner__link hold-banner__link--muted" bindtap="onTapRemoveHold">取消标记</text>
        </view>
      </view>

      <view wx:if="{{showHoldEditor}}" class="hold-editor">
        <text class="hold-editor__label">事由（1-20字）</text>
        <input
          class="hold-editor__input"
          value="{{holdReasonDraft}}"
          maxlength="20"
          focus="{{showHoldEditor}}"
          placeholder="例如：出差、家里有事"
          placeholder-class="ph"
          bindinput="onHoldReasonInput"
          confirm-type="done"
          bindconfirm="onSaveHold"
        />
        <view class="hold-editor__actions">
          <text class="hold-banner__link hold-banner__link--muted" bindtap="onCancelHoldEditor">取消</text>
          <text class="hold-banner__link" bindtap="onSaveHold">保存</text>
        </view>
      </view>

      <view wx:if="{{dayBookings.length}}">
        <booking-item
          wx:for="{{dayBookings}}"
          wx:key="_id"
          bookingId="{{item._id}}"
          studentName="{{item.studentName}}"
          teacherName="{{item.teacherName}}"
          subjectName="{{item.subjectName}}"
          startTime="{{item.startTime}}"
          endTime="{{item.endTime}}"
          tone="{{item.cardTone}}"
          teacherTone="{{item.cardTone}}"
          statusLabel="{{item.statusLabel}}"
          status="{{item.status}}"
          teacherAvatarUrl="{{item.teacherAvatarUrl}}"
          teacherInitial="{{item.teacherInitial}}"
          note="{{item.note}}"
          bind:tap="onTapBooking"
        />
      </view>
      <empty-state
        wx:elif="{{selectedHoldReason}}"
        text="这天有事，最好别约"
        hint="点底部 + 号仍可加课（会再确认）"
      />
      <empty-state
        wx:else
        text="这天还空着"
        hint="点底部 + 号，加一节课吧"
      />
    </block>

    <block wx:else>
      <view wx:if="{{timelineGroups.length}}" class="tl-toolbar">
        <text class="tl-toolbar__hint">
          {{selecting ? (selectedCount ? '已选 ' + selectedCount + ' 节' : '点课程勾选') : summaryText}}
        </text>
        <view wx:if="{{!selecting}}" class="tl-toolbar__actions">
          <view class="tl-toolbar__save" bindtap="onEnterSelect">管理</view>
          <view class="tl-toolbar__save" bindtap="onSaveTimelinePoster">保存长图</view>
        </view>
        <view wx:else class="tl-toolbar__actions">
          <view class="tl-toolbar__save" bindtap="onSelectAllTimeline">全选</view>
          <view class="tl-toolbar__save tl-toolbar__save--muted" bindtap="onCancelSelect">取消</view>
        </view>
      </view>
      <timeline-list
        wx:if="{{timelineGroups.length}}"
        groups="{{timelineGroups}}"
        selecting="{{selecting}}"
        selected-map="{{selectedMap}}"
        bind:itemtap="onTapTimelineItem"
      />
      <empty-state
        wx:else
        text="本月还没有课"
        hint="点底部 + 号，开始记第一节"
      />
    </block>
  </view>
  <view wx:if="{{selecting && mode !== 'calendar'}}" class="tl-delbar">
    <view
      class="tl-delbar__btn {{selectedCount ? '' : 'is-disabled'}}"
      bindtap="onConfirmBatchDelete"
    >删除 {{selectedCount}} 节</view>
  </view>
  <canvas type="2d" id="tlPosterCanvas" class="tl-poster-canvas"></canvas>
</view>
