.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
  gap: 12rpx;
}

.section-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.section-btn {
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
}

.section-btn:active {
  transform: scale(0.94);
  opacity: 0.9;
}

.section-btn__ico {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-btn__ico--hold {
  background: linear-gradient(145deg, #94a3b8, #64748b);
  box-shadow: 0 4rpx 10rpx rgba(100, 116, 139, 0.3);
}

.section-btn__ico--batch {
  background: linear-gradient(145deg, #60a5fa, #3b82f6);
  box-shadow: 0 4rpx 10rpx rgba(59, 130, 246, 0.32);
}

.section-btn__ico--copy {
  background: linear-gradient(145deg, #34d399, #10b981);
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.28);
}

.section-btn__ico--del {
  background: linear-gradient(145deg, #fb7185, #ef4444);
  box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.28);
}

/* 其他安排：小日历 + 斜杠 */
.ico-hold {
  width: 22rpx;
  height: 20rpx;
  border: 2.5rpx solid #fff;
  border-radius: 3rpx;
  position: relative;
  box-sizing: border-box;
}

.ico-hold::before {
  content: '';
  position: absolute;
  left: -1rpx;
  right: -1rpx;
  top: 4rpx;
  height: 2.5rpx;
  background: #fff;
}

.ico-hold::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -2rpx;
  width: 2.5rpx;
  height: 24rpx;
  background: #fff;
  border-radius: 2rpx;
  transform: translateX(-50%) rotate(-42deg);
  box-shadow: 0 0 0 2rpx rgba(100, 116, 139, 0.35);
}

/* 批量新增：四点宫格 */
.ico-batch {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.ico-batch::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 7rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: #fff;
  box-shadow: 13rpx 0 0 #fff, 0 13rpx 0 #fff, 13rpx 13rpx 0 #fff;
}

/* 复制上月：双层卡片 */
.ico-copy {
  width: 18rpx;
  height: 18rpx;
  border: 2.5rpx solid #fff;
  border-radius: 3rpx;
  position: relative;
  box-sizing: border-box;
  margin-top: 2rpx;
  margin-left: 2rpx;
}

.ico-copy::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 2.5rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 3rpx;
  box-sizing: border-box;
}

.ico-del {
  width: 16rpx;
  height: 18rpx;
  border: 2.5rpx solid #fff;
  border-top: none;
  border-radius: 0 0 3rpx 3rpx;
  position: relative;
  box-sizing: border-box;
  margin-top: 6rpx;
}

.ico-del::before {
  content: '';
  position: absolute;
  left: -4rpx;
  top: -5rpx;
  width: 20rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
}

.ico-del::after {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 3rpx;
  width: 2.5rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 2rpx;
  box-shadow: 6rpx 0 0 #fff;
}

.hold-banner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(100, 116, 139, 0.1);
}

.hold-banner__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hold-banner__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.hold-banner__reason {
  font-size: 26rpx;
  color: #475569;
}

.hold-banner__hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.hold-banner__actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.hold-banner__link {
  font-size: 24rpx;
  color: #3b82f6;
  font-weight: 600;
}

.hold-banner__link--muted {
  color: #94a3b8;
  font-weight: 500;
}

.hold-editor {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.hold-editor__label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.hold-editor__input {
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 28rpx;
  color: #1b2430;
}

.hold-editor__actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 16rpx;
}

.ph {
  color: #cbd5e1;
}

/* 学员切换：内容区呼出 */
.cal-stage {
  transform-origin: center top;
}

.cal-stage.is-out {
  opacity: 0.35;
  transform: scale(0.97) translateY(8rpx);
  transition: opacity 90ms ease-in, transform 90ms ease-in;
}

.cal-stage.is-in {
  opacity: 1;
  transform: scale(1) translateY(0);
  animation: cal-pop-in 160ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes cal-pop-in {
  0% {
    opacity: 0.4;
    transform: scale(0.96) translateY(12rpx);
  }
  70% {
    opacity: 1;
    transform: scale(1.02) translateY(0);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.tl-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 4rpx 16rpx;
}

.tl-toolbar__hint {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #8b95a5;
}

.tl-toolbar__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-toolbar__save {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #3b82f6;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(27, 36, 48, 0.06);
}

.tl-toolbar__save--muted {
  color: #8b95a5;
}

.tl-toolbar__save:active {
  opacity: 0.85;
}

.tl-delbar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom) + 8rpx);
  z-index: 20;
}

.tl-delbar__btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(239, 68, 68, 0.32);
}

.tl-delbar__btn.is-disabled {
  background: #c5ccd6;
  box-shadow: none;
}

.page.is-selecting {
  padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom) + 160rpx);
}

.tl-poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 375px;
  height: 667px;
  pointer-events: none;
}
