.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
  gap: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.section-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.section-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d8dee8;
  background: #fff;
  font-size: 22rpx;
  color: #5b6573;
  font-weight: 500;
}

.section-btn__icon {
  font-size: 20rpx;
  opacity: 0.7;
}
