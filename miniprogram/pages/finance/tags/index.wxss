.tags {
  background: #f0f0f3;
  padding: 16rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}
.head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.add {
  color: #1c7ed6;
  font-weight: 400;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8f9fa;
}
.fi {
  flex: 1;
  border: 1rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.del {
  color: #c92a2a;
  font-size: 32rpx;
}
.empty {
  text-align: center;
  color: #868e96;
  padding: 40rpx;
  font-size: 24rpx;
}
