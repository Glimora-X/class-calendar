.cf {
  background: #f0f0f3;
  padding: 16rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.lab {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.fi {
  border: 1rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.add {
  color: #1c7ed6;
  font-weight: 400;
  font-size: 24rpx;
}
.bcf-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8f9fa;
}
.cell {
  border: 1rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  min-width: 0;
}
.amt {
  width: 120rpx;
}
.rem {
  flex: 1;
}
.del {
  color: #c92a2a;
  font-size: 32rpx;
  padding: 0 8rpx;
}
.fa {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
}
.btn {
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
}
.btn::after {
  border: none;
}
.btn-s {
  background: #f1f3f5;
  color: #495057;
  flex: 1;
}
.btn-p {
  background: #1a1a1a;
  color: #fff;
  flex: 2;
}
