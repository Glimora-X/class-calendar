.hint,
.fail {
  color: var(--color-muted);
}

.status {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(245, 158, 11, 0.16);
  color: #b45309;
  font-size: 24rpx;
}

.spark {
  width: 100%;
  height: 180rpx;
  margin: 12rpx 0;
}

.picked {
  color: var(--color-primary-deep);
  font-size: 24rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 26rpx;
}

.mark {
  color: var(--color-muted);
}

.is-merge {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx;
  border: none;
  border-radius: 16rpx;
  background: rgba(139, 92, 246, 0.12);
  color: #6d28d9;
  font-weight: 600;
}

.is-source {
  background: rgba(139, 92, 246, 0.06);
}
