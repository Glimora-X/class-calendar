.rc {
  background: #f0f0f3;
  padding-top: 8rpx;
}

.rc-sum {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.06);
  margin-bottom: 20rpx;
}

.rc-sum__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.rc-sum__lab {
  font-size: 26rpx;
  color: #5c6675;
  font-weight: 500;
}

.rc-sum__val {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.rc-sum__meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b95a5;
}

.rc-sum__hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #74a9d8;
  line-height: 1.4;
}

.rc-day {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.rc-day__lab {
  font-size: 24rpx;
  color: #5c6675;
  flex: 1;
}

.rc-day__val {
  font-size: 28rpx;
  font-weight: 600;
}

.rc-day__badge {
  font-size: 20rpx;
  color: #1c7ed6;
  background: rgba(28, 126, 214, 0.12);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.pos {
  color: #c92a2a;
}

.neg {
  color: #2f9e44;
}

.neutral {
  color: #868e96;
}
