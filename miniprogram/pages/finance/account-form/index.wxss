.form {
  --form-pad-x: 32rpx;
  --form-field: #ffffff;
  --form-field-ink: #1b2430;
  --form-muted: #8b95a5;
  --form-lab: #5c6675;
  --form-chip: #e8edf3;
  --form-chip-ink: #3d4654;
  --form-line: #dbe2ea;
  --form-accent: #3b82f6;
  --form-accent-deep: #2563eb;
  --form-accent-soft: rgba(59, 130, 246, 0.12);

  background: #f0f0f3;
  padding: 20rpx var(--form-pad-x) 0;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-body {
  padding-bottom: 20rpx;
}

.fg {
  margin-bottom: 28rpx;
}

.fl {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  min-height: 30rpx;
}

.lab {
  font-size: 24rpx;
  color: var(--form-lab);
  font-weight: 500;
}

.hint {
  font-size: 20rpx;
  color: var(--form-muted);
  line-height: 1.2;
}

.hint--req {
  color: #e03131;
}

.fi {
  width: 100%;
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--form-field);
  border: 1rpx solid var(--form-line);
  color: var(--form-field-ink);
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.fi-ph {
  color: #a8b0bc;
  font-weight: 400;
}

.ta {
  height: auto;
  min-height: 140rpx;
  padding: 20rpx 22rpx;
  line-height: 1.45;
  font-weight: 400;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--form-chip-ink);
  background: var(--form-chip);
  border: 2rpx solid transparent;
  text-align: center;
  box-sizing: border-box;
}

.chip.is-on {
  background: var(--form-accent-soft);
  color: var(--form-accent-deep);
  border-color: var(--form-accent);
  font-weight: 600;
}

.err {
  margin-top: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(239, 68, 68, 0.1);
  color: var(--color-danger);
  font-size: 24rpx;
}

.fa {
  display: flex;
  gap: 16rpx;
  margin-left: calc(0rpx - var(--form-pad-x));
  margin-right: calc(0rpx - var(--form-pad-x));
  padding: 16rpx var(--form-pad-x) calc(24rpx + env(safe-area-inset-bottom));
  position: sticky;
  bottom: 0;
  z-index: 10;
  background: #f0f0f3;
  box-shadow: 0 -12rpx 24rpx rgba(240, 240, 243, 0.92);
  box-sizing: border-box;
}

.btn {
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn::after {
  border: none;
}

.btn-s {
  flex: 1;
  background: #ffffff;
  color: #5c6675;
  border: 1rpx solid var(--form-line);
}

.btn-p {
  flex: 2.4;
  color: #ffffff;
  background: linear-gradient(90deg, #60a5fa 0%, #3b82f6 55%, #2563eb 100%);
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.26);
}

.btn-p[disabled] {
  opacity: 0.45;
}
