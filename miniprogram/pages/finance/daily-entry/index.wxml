<view class="page page--no-tab daily">
  <view class="card">
    <view class="row">
      <text class="lab">收益日期</text>
      <view class="chips">
        <text class="chip {{dateOffset===-1?'active':''}}" data-o="-1" bindtap="onDatePreset">昨天</text>
        <text class="chip {{dateOffset===0?'active':''}}" data-o="0" bindtap="onDatePreset">今天</text>
      </view>
    </view>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="fi">{{date}}</view>
    </picker>
  </view>

  <block wx:for="{{groups}}" wx:key="platform">
    <view class="plat">
      <view class="plat__head">
        <text class="plat__name">{{item.platform}}</text>
        <text class="plat__count">{{item.count}} 只</text>
      </view>
      <view
        wx:for="{{item.rows}}"
        wx:for-item="row"
        wx:key="id"
        class="daily-item {{row.cls}}"
      >
        <view class="di-info">
          <view class="di-n">{{row.name}}</view>
          <view class="di-s">{{row.code}} · 余额 ¥{{row.eodText}}</view>
          <view wx:if="{{row.hint}}" class="di-ex">{{row.hint}}</view>
        </view>
        <view class="di-ia">
          <input
            class="di-in"
            type="digit"
            placeholder="日收益"
            value="{{row.value}}"
            data-id="{{row.id}}"
            bindinput="onInput"
          />
          <view
            class="di-sv {{row.value===''?'off':''}}"
            data-id="{{row.id}}"
            bindtap="onSaveOne"
          >✓</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!rowCount}}" class="empty">暂无持仓产品</view>

  <view class="btm">
    <view class="prog">已填 {{filled}} / {{rowCount}}</view>
    <button class="btn btn-go" bindtap="onSubmit">保存已填的 {{filled}} 条</button>
  </view>
</view>
