.closed {
  background: #f0f0f3;
  padding: 16rpx;
}
.cli-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.ch {
  margin-bottom: 16rpx;
}
.cn {
  font-size: 26rpx;
  font-weight: 500;
}
.cm {
  font-size: 22rpx;
  color: #868e96;
  margin-top: 8rpx;
}
.cp {
  font-size: 24rpx;
  margin-top: 12rpx;
}
.cp.pos {
  color: #2b8a3e;
}
.cp.neg {
  color: #c92a2a;
}
.ca {
  display: flex;
  gap: 12rpx;
}
.btn {
  flex: 1;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx;
  border: none;
}
.btn::after {
  border: none;
}
.btn-s {
  background: #f1f3f5;
  color: #495057;
}
.btn-d {
  background: #c92a2a;
  color: #fff;
}
