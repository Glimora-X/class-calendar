.hint,
.fail {
  color: var(--color-muted);
  line-height: 1.6;
}

.card {
  margin-top: 16rpx;
  padding: 24rpx;
}

.card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card__head-main {
  flex: 1;
  min-width: 0;
}

.card__date {
  color: var(--color-muted);
  font-size: 24rpx;
}

.card__net {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.card__tpl {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(139, 92, 246, 0.35);
  background: rgba(139, 92, 246, 0.08);
  color: #6d28d9;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.card__note {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(139, 92, 246, 0.14);
  color: #6d28d9;
  font-size: 20rpx;
}

.detail {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-line);
}

.detail__title {
  margin-bottom: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.detail__cols,
.detail__row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail__cols {
  margin-bottom: 6rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.detail__row {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eef2f7;
  font-size: 22rpx;
}

.detail__row:last-child {
  border-bottom: none;
}

.detail__col {
  flex: 1.1;
  text-align: right;
  min-width: 0;
}

.detail__col--name {
  flex: 1.4;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail__col--strong {
  font-weight: 600;
}

.delta--up {
  color: var(--color-danger);
  font-weight: 600;
}

.delta--down {
  color: #059669;
  font-weight: 600;
}

.delta--first {
  color: var(--color-primary);
  font-weight: 600;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(27, 36, 48, 0.4);
}

.sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet__lead {
  margin-top: 12rpx;
  color: var(--color-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.impact {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
}

.impact__item {
  position: relative;
  padding-left: 22rpx;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.impact__item:first-child {
  margin-top: 0;
}

.impact__item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-pro);
}

.sheet__row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet__row button {
  flex: 1;
}
