.invest {
  padding: 0;
  padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom) + 120rpx);
  background: #f0f0f3;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom) + 24rpx);
  width: 96rpx;
  height: 96rpx;
  background: #1a1a1a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 50;
}

.quick-links {
  margin: 16rpx 32rpx 32rpx;
  display: flex;
  gap: 24rpx;
  justify-content: center;
}
.ql {
  font-size: 24rpx;
  color: #1c7ed6;
}
