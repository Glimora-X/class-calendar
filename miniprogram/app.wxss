page {
  --color-bg: #eef2f7;
  --color-surface: #ffffff;
  --color-ink: #1b2430;
  --color-muted: #8b95a5;
  --color-line: #e6ebf2;
  --color-primary: #3b82f6;
  --color-primary-soft: rgba(59, 130, 246, 0.18);
  --color-primary-deep: #2563eb;
  --color-mint: #34d399;
  --color-mint-soft: rgba(52, 211, 153, 0.22);
  --color-pro: #8b5cf6;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --shadow-card: 0 12rpx 40rpx rgba(27, 36, 48, 0.08);
  --shadow-fab: 0 16rpx 36rpx rgba(59, 130, 246, 0.35);
  --radius-card: 28rpx;
  --radius-chip: 999rpx;
  /* 悬浮 tab：底垫 16 + 栏高 112 + 中间 + 上凸约 56 */
  --tab-bar-height: 184rpx;
  --page-pad: 32rpx;

  background: var(--color-bg);
  color: var(--color-ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    sans-serif;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--page-pad);
  /* 额外 64rpx：最后一节能完整滚到 FAB 上方可读 */
  padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom) + 64rpx);
}

.page--no-tab {
  padding-bottom: calc(var(--page-pad) + env(safe-area-inset-bottom));
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-chip);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-fab);
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: var(--color-surface);
  color: var(--color-ink);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-chip);
}

.btn-ghost::after {
  border: none;
}

.surface-card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
