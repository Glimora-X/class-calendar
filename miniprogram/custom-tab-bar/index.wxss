.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  padding: 0 16rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-bar {
  pointer-events: auto;
  height: 112rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  position: relative;
}

.tab-item {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.55;
}

.tab-item.is-active {
  opacity: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #8b95a5;
}

.tab-item.is-active .tab-text {
  color: #3b82f6;
  font-weight: 600;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #8b95a5;
  border-radius: 10rpx;
}

.tab-item.is-active .tab-icon {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.12);
}

.tab-icon--calendar {
  border-radius: 8rpx;
}

.tab-icon--overview {
  border-radius: 8rpx;
  background: linear-gradient(
    135deg,
    transparent 0 42%,
    currentColor 42% 58%,
    transparent 58%
  );
  border-color: #8b95a5;
  position: relative;
}

.tab-icon--overview::before,
.tab-icon--overview::after {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  height: 4rpx;
  background: #8b95a5;
  border-radius: 2rpx;
}

.tab-icon--overview::before {
  top: 10rpx;
}

.tab-icon--overview::after {
  bottom: 10rpx;
}

.tab-item.is-active .tab-icon--overview::before,
.tab-item.is-active .tab-icon--overview::after {
  background: #3b82f6;
}

.tab-icon--mine {
  border-radius: 50%;
}

.tab-fab-slot {
  width: 112rpx;
  display: flex;
  justify-content: center;
}

.tab-fab {
  width: 108rpx;
  height: 108rpx;
  margin-top: -58rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #60a5fa 0%, #3b82f6 100%);
  box-shadow: 0 16rpx 40rpx rgba(59, 130, 246, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-fab__plus {
  color: #fff;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}
