.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  padding: 0 16rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-bar {
  pointer-events: auto;
  height: 112rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  position: relative;
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.55;
}

.tab-item.is-active {
  opacity: 1;
}

.tab-text {
  max-width: 100%;
  font-size: 20rpx;
  color: #8b95a5;
  white-space: nowrap;
}

.tab-item.is-active .tab-text {
  color: #3b82f6;
  font-weight: 600;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #8b95a5;
  border-radius: 10rpx;
}

.tab-item.is-active .tab-icon {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.12);
}

.tab-icon--calendar {
  border-radius: 8rpx;
}

.tab-icon--assets {
  border-radius: 6rpx;
  position: relative;
}

.tab-icon--assets::before {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 10rpx;
  height: 4rpx;
  background: #8b95a5;
  border-radius: 2rpx;
}

.tab-item.is-active .tab-icon--assets::before {
  background: #3b82f6;
}

.tab-icon--invest {
  border-radius: 8rpx;
  position: relative;
}

.tab-icon--invest::before,
.tab-icon--invest::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 6rpx;
  border-radius: 2rpx;
  background: #8b95a5;
}

.tab-icon--invest::before {
  left: 8rpx;
  height: 10rpx;
}

.tab-icon--invest::after {
  right: 8rpx;
  height: 18rpx;
}

.tab-item.is-active .tab-icon--invest::before,
.tab-item.is-active .tab-icon--invest::after {
  background: #3b82f6;
}

.tab-icon--mine {
  border-radius: 50%;
}
