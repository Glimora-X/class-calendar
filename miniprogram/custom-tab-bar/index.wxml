<view class="tab-shell">
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'is-active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon tab-icon--{{item.icon}}"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
