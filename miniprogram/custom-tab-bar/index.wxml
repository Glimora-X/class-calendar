<view class="tab-shell">
  <view class="tab-bar">
    <view
      class="tab-item {{selected === 0 ? 'is-active' : ''}}"
      data-index="0"
      bindtap="switchTab"
    >
      <view class="tab-icon tab-icon--calendar"></view>
      <text class="tab-text">日历</text>
    </view>

    <view class="tab-fab-slot">
      <view class="tab-fab" bindtap="onFab">
        <text class="tab-fab__plus">+</text>
      </view>
    </view>

    <view
      class="tab-item {{selected === 1 ? 'is-active' : ''}}"
      data-index="1"
      bindtap="switchTab"
    >
      <view class="tab-icon tab-icon--mine"></view>
      <text class="tab-text">我的</text>
    </view>
  </view>
</view>
