.ns {
  position: relative;
}

.soft-field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding-right: 20rpx;
  border-bottom: 1rpx solid #e6ebf2;
}

.soft-field__label {
  width: 120rpx;
  flex-shrink: 0;
  color: #8b95a5;
  font-size: 26rpx;
  font-weight: 600;
}

.soft-field__input {
  flex: 1;
  font-size: 30rpx;
  color: #1b2430;
  font-weight: 500;
}

.ph {
  color: #b0b8c4;
}

.ns__list {
  position: absolute;
  left: 120rpx;
  right: 8rpx;
  top: 96rpx;
  z-index: 20;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(27, 36, 48, 0.12);
  overflow: hidden;
  max-height: 360rpx;
}

.ns__item {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1b2430;
  border-bottom: 1rpx solid #eef2f7;
}

.ns__item:last-child {
  border-bottom: none;
}

.ns__item:active {
  background: rgba(59, 130, 246, 0.06);
}
