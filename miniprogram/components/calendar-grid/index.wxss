.cal {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx 20rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.08);
  margin-bottom: 32rpx;
}

.cal__weekdays,
.cal__grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.cal__wd {
  text-align: center;
  font-size: 22rpx;
  color: #8b95a5;
  padding-bottom: 16rpx;
  font-weight: 600;
}

.cal__cell {
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cal__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.cal__day-wrap {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.cal__day {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1b2430;
  line-height: 56rpx;
  text-align: center;
}

.cal__hold-mark {
  position: absolute;
  top: -4rpx;
  right: -10rpx;
  min-width: 24rpx;
  height: 24rpx;
  padding: 0 4rpx;
  border-radius: 8rpx;
  background: #64748b;
  color: #fff;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 24rpx;
  text-align: center;
  z-index: 1;
}

.cal__cell.is-hold:not(.is-selected) .cal__day {
  background: rgba(100, 116, 139, 0.12);
  color: #475569;
}

.cal__cell.is-hold.is-selected .cal__hold-mark {
  background: rgba(255, 255, 255, 0.92);
  color: #475569;
}

.cal__cell.is-other .cal__day {
  color: #c5cdd8;
  font-weight: 500;
  background: transparent;
  box-shadow: none;
}

.cal__cell.is-other {
  pointer-events: none;
}

.cal__holiday {
  font-size: 16rpx;
  color: #ef4444;
  line-height: 1.1;
  max-width: 72rpx;
  overflow: hidden;
  white-space: nowrap;
  text-align: center;
}

.cal__summary {
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #2563eb;
  max-width: 72rpx;
  overflow: hidden;
  white-space: nowrap;
  text-align: center;
}

.cal__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 10rpx;
}

.cal__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3b82f6;
}

.cal__dot.tone-primary {
  background: #3b82f6;
}

.cal__dot.tone-mint {
  background: #34d399;
}

.cal__dot.tone-pro {
  background: #8b5cf6;
}

.cal__dot.tone-warning {
  background: #f59e0b;
}

.cal__cell.has-mark .cal__day {
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.25);
}

.cal__cell.tone-primary .cal__day {
  background: rgba(59, 130, 246, 0.18);
  color: #2563eb;
}

.cal__cell.tone-mint .cal__day {
  background: rgba(52, 211, 153, 0.22);
  color: #059669;
  box-shadow: 0 8rpx 24rpx rgba(52, 211, 153, 0.28);
}

.cal__cell.tone-mint .cal__summary {
  color: #059669;
}

.cal__cell.tone-pro .cal__day {
  background: rgba(139, 92, 246, 0.2);
  color: #7c3aed;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.28);
}

.cal__cell.tone-pro .cal__summary {
  color: #7c3aed;
}

.cal__cell.tone-warning .cal__day {
  background: rgba(245, 158, 11, 0.22);
  color: #d97706;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.28);
}

.cal__cell.tone-warning .cal__summary {
  color: #d97706;
}

.cal__cell.is-selected .cal__day {
  background: #3b82f6;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(59, 130, 246, 0.4);
}

.cal__cell.is-selected .cal__holiday,
.cal__cell.is-selected .cal__summary {
  color: rgba(255, 255, 255, 0.9);
}

/* 选中日圆点保持老师色（不改白） */
.cal__cell.is-selected .cal__dot.tone-primary {
  background: #3b82f6;
}

.cal__cell.is-selected .cal__dot.tone-mint {
  background: #34d399;
}

.cal__cell.is-selected .cal__dot.tone-pro {
  background: #8b5cf6;
}

.cal__cell.is-selected .cal__dot.tone-warning {
  background: #f59e0b;
}

.cal__cell.is-today:not(.is-selected) .cal__day {
  border: 2rpx solid #3b82f6;
}

.cal__legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef1f6;
}

.cal__legend-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.cal__legend-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #3b82f6;
}

.cal__legend-dot.tone-primary {
  background: #3b82f6;
}

.cal__legend-dot.tone-mint {
  background: #34d399;
}

.cal__legend-dot.tone-pro {
  background: #8b5cf6;
}

.cal__legend-dot.tone-warning {
  background: #f59e0b;
}

.cal__legend-name {
  font-size: 22rpx;
  color: #8b95a5;
}
