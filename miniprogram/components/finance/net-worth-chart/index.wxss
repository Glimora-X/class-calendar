.nw {
  margin-top: 16rpx;
  padding: 24rpx 28rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f7fafc 100%);
  border: 1rpx solid rgba(42, 130, 228, 0.08);
  box-shadow: 0 8rpx 28rpx rgba(11, 56, 110, 0.05);
}

.nw__head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.nw__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0d1c2e;
}

.nw__sub {
  font-size: 22rpx;
  color: #8b95a5;
}

.nw__empty {
  margin-top: 16rpx;
  color: #8b95a5;
  font-size: 24rpx;
  line-height: 1.5;
}

.nw__canvas {
  width: 100%;
  height: 200rpx;
  margin-top: 12rpx;
}

.nw__panel {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 40, 70, 0.06);
}

.nw__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.nw__row--main {
  margin-top: 0;
}

.nw__date {
  font-size: 24rpx;
  color: #5f6e82;
  font-weight: 500;
}

.nw__net {
  font-size: 30rpx;
  font-weight: 800;
  color: #0d1c2e;
}

.nw__lab {
  font-size: 22rpx;
  color: #8b95a5;
}

.nw__val {
  font-size: 26rpx;
  font-weight: 700;
  color: #0d1c2e;
}

.nw__split {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.nw__chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(59, 130, 246, 0.06);
}

.nw__hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b95a5;
  line-height: 1.4;
}

.tone-pos {
  color: #059669;
}

.tone-neg {
  color: #dc2626;
}

.tone-neutral {
  color: #0d1c2e;
}
