.filter-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 199;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.filter-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}
.filter-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 85%;
  max-width: 720rpx;
  background: #fff;
  z-index: 200;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  box-shadow: -4rpx 0 24rpx rgba(0, 0, 0, 0.1);
}
.filter-panel.open {
  transform: translateX(0);
}
.filter-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e9ecef;
  flex-shrink: 0;
  padding-top: calc(28rpx + env(safe-area-inset-top));
}
.fph-title {
  font-size: 32rpx;
  font-weight: 600;
}
.fph-close {
  font-size: 44rpx;
  color: #868e96;
  line-height: 1;
}
.filter-panel-body {
  flex: 1;
  height: 0;
  padding: 8rpx 0;
}
.fs-lab {
  font-size: 20rpx;
  color: #868e96;
  padding: 12rpx 24rpx 4rpx;
}
.filter-row {
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
}
.fp {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  background: #f1f3f5;
  color: #495057;
  margin-right: 12rpx;
}
.fp.active {
  background: #1a1a1a;
  color: #fff;
  font-weight: 500;
}
.fp-cnt {
  font-size: 18rpx;
  opacity: 0.7;
}
.filter-panel-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e9ecef;
  flex-shrink: 0;
}
.btn {
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn::after {
  border: none;
}
.btn-s {
  background: #f1f3f5;
  color: #495057;
  flex: 1;
}
.btn-p {
  background: #1a1a1a;
  color: #fff;
  flex: 2;
}
