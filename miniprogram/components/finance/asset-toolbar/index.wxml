<view class="toolbar">
  <view class="tb-filter" bindtap="onFilter">
    <text class="tb-fi-icon">≡</text>
    <text class="tb-fi-text">筛选</text>
    <view wx:if="{{filterCount > 0}}" class="tb-fi-badge">{{filterCount}}</view>
  </view>
  <view class="tb-summary" bindtap="onToggleSummary">
    <text class="ts-total">{{summary.count}}只</text>
    <text wx:if="{{summary.multiCurrency}}"> · 多币种</text>
    <block wx:else>
      <text> · 本金¥{{summary.principalText}}</text>
      <text> · 余额¥{{summary.eodText}}</text>
      <text class="{{summary.profitTone}}"> · {{summary.profitSign}}{{summary.profitText}}</text>
    </block>
  </view>
  <view class="tb-sort" bindtap="onSort">{{sortLabel}}</view>
</view>
