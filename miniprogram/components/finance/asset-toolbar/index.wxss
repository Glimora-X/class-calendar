.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #e9ecef;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tb-filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.tb-fi-icon {
  font-size: 28rpx;
}
.tb-fi-text {
  font-size: 26rpx;
  font-weight: 500;
}
.tb-fi-badge {
  background: #c92a2a;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}
.tb-summary {
  flex: 1;
  font-size: 22rpx;
  color: #868e96;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ts-total {
  font-weight: 600;
  color: #1a1a1a;
}
.tb-sort {
  font-size: 24rpx;
  color: #1c7ed6;
  flex-shrink: 0;
  white-space: nowrap;
}
.pos {
  color: #c92a2a;
}
.neg {
  color: #2f9e44;
}
