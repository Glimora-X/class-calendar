.advice-badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}
.ad-EXIT {
  background: #ffe3e3;
  color: #c92a2a;
}
.ad-REDUCE {
  background: #fff4e6;
  color: #e8590c;
}
.ad-ADD {
  background: #d0ebff;
  color: #1c7ed6;
}
.ad-WATCH {
  background: #f3f0ff;
  color: #7048e8;
}
.ad-HOLD {
  background: #f1f3f5;
  color: #868e96;
}
