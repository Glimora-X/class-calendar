.product-card {
  background: #fff;
  margin: 16rpx;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}
.pc-h {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.pc-left {
  flex: 1;
  min-width: 0;
}
.pc-n {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}
.pc-tg {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.tag-risk {
  background: #e7f5ff;
  color: #1c7ed6;
}
.tag-ch {
  background: #ebfbee;
  color: #2f9e44;
}
.tag-cu {
  background: #f3f0ff;
  color: #7048e8;
}
.tag-rt {
  background: #f1f3f5;
  color: #868e96;
}
.tag-we {
  background: #fff4e6;
  color: #e8590c;
}
.pc-m {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8rpx;
}
.pl {
  font-size: 20rpx;
  color: #868e96;
}
.pv {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 2rpx;
}
.sc-badge {
  font-size: 18rpx;
  color: #e8590c;
  background: #fff4e6;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  font-weight: 500;
}
.pc-f {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e9ecef;
}
.pc-fi {
  font-size: 22rpx;
  color: #868e96;
}
.pc-fi.hi {
  color: #1c7ed6;
  font-weight: 500;
}
.pc-fi.warn {
  color: #e8590c;
}
.pos {
  color: #c92a2a;
}
.neg {
  color: #2f9e44;
}
.neutral {
  color: #868e96;
}
.muted {
  color: #868e96;
}
