.subject-picker {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.08);
}

.subject-picker--embedded {
  background: transparent;
  border-radius: 0;
  padding: 18rpx 4rpx 22rpx;
  box-shadow: none;
  border-bottom: 1rpx solid #f0f2f5;
}

.subject-picker__label {
  font-size: 20rpx;
  color: #9aa3b2;
  font-weight: 400;
  letter-spacing: 0.02em;
  margin-bottom: 10rpx;
}

.subject-picker__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52rpx;
}

.subject-picker__value {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a2332;
}

.subject-picker__action {
  font-size: 24rpx;
  color: #5b8def;
  font-weight: 600;
  flex-shrink: 0;
}

.subject-picker__add {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e6ebf2;
}

.subject-picker__input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #eef2f7;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.subject-picker__add-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
