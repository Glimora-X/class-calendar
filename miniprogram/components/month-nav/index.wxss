.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 28rpx;
}

.month-nav__side {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(27, 36, 48, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.chev {
  font-size: 44rpx;
  color: #1b2430;
  line-height: 1;
  margin-top: -4rpx;
}

.month-nav__center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.month-nav__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.month-nav__sub {
  font-size: 22rpx;
  color: #8b95a5;
}
