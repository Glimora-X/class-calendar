.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 28rpx;
}

.month-nav__side {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(27, 36, 48, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chev {
  font-size: 44rpx;
  color: #1b2430;
  line-height: 1;
  height: 44rpx;
}

.month-nav__center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 0;
  padding: 0 12rpx;
}

.month-nav__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  text-align: center;
}

.month-nav__sub-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  max-width: 100%;
  line-height: 1;
}

.month-nav__sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #8b95a5;
  line-height: 32rpx;
  height: 32rpx;
}

.month-nav__sep {
  color: #c5cdd8;
  flex-shrink: 0;
}
