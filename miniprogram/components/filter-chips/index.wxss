.chips {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.chips__inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 2rpx 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8b95a5;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  box-shadow: 0 8rpx 20rpx rgba(27, 36, 48, 0.05);
  border: 2rpx solid transparent;
}

.chip.is-active {
  background: #3b82f6;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(59, 130, 246, 0.3);
}

/* 老师色：未选中描边/字色，选中铺满 */
.chip.tone-primary:not(.is-active) {
  color: #2563eb;
  background: rgba(59, 130, 246, 0.12);
  border-color: transparent;
}

.chip.tone-primary.is-active {
  background: #3b82f6;
  box-shadow: 0 12rpx 28rpx rgba(59, 130, 246, 0.3);
}

.chip.tone-mint:not(.is-active) {
  color: #059669;
  background: rgba(52, 211, 153, 0.16);
  border-color: transparent;
}

.chip.tone-mint.is-active {
  background: #34d399;
  box-shadow: 0 12rpx 28rpx rgba(52, 211, 153, 0.35);
}

.chip.tone-pro:not(.is-active) {
  color: #7c3aed;
  background: rgba(139, 92, 246, 0.14);
  border-color: transparent;
}

.chip.tone-pro.is-active {
  background: #8b5cf6;
  box-shadow: 0 12rpx 28rpx rgba(139, 92, 246, 0.35);
}

.chip.tone-warning:not(.is-active) {
  color: #d97706;
  background: rgba(245, 158, 11, 0.16);
  border-color: transparent;
}

.chip.tone-warning.is-active {
  background: #f59e0b;
  box-shadow: 0 12rpx 28rpx rgba(245, 158, 11, 0.35);
}
