<scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
  <view class="chips__inner">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="chip {{item.active ? 'is-active' : ''}} {{item.tone ? 'tone-' + item.tone : ''}} {{item.variant === 'student' ? 'chip--student' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTap"
    >
      <view wx:if="{{item.variant === 'student' && item.id !== 'all'}}" class="chip__dot"></view>
      <text>{{item.label}}</text>
    </view>
  </view>
</scroll-view>
