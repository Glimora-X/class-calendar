<view class="tl">
  <view wx:for="{{groups}}" wx:key="date" class="tl__row">
    <view class="tl__date">
      <text class="tl__day">{{item.day}}</text>
      <text class="tl__wd">{{item.weekdayLabel}}</text>
    </view>
    <view class="tl__rail">
      <view class="tl__dot tl__dot--{{item.statusDotClass || 'pending'}}"></view>
      <view class="tl__line"></view>
    </view>
    <view class="tl__cards">
      <timeline-booking-card
        wx:for="{{item.items}}"
        wx:for-item="b"
        wx:key="_id"
        booking-id="{{b._id}}"
        start-time="{{b.startTime}}"
        end-time="{{b.endTime}}"
        status="{{b.status}}"
        status-label="{{b.statusLabel}}"
        teacher-name="{{b.teacherName}}"
        teacher-initial="{{b.teacherInitial}}"
        student-name="{{b.studentName}}"
        subject-name="{{b.subjectName}}"
        meta-line="{{b.metaLine}}"
        bind:tap="onTapItem"
      />
    </view>
  </view>
</view>
