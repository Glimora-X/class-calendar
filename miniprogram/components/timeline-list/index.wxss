.tl {
  padding-top: 8rpx;
}

.tl__row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  min-height: 120rpx;
  margin-bottom: 8rpx;
}

.tl__date {
  width: 96rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tl__day {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.tl__wd {
  font-size: 20rpx;
  color: #8b95a5;
}

.tl__rail {
  width: 28rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.tl__dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #3b82f6;
  background: #fff;
  margin-top: 18rpx;
  z-index: 1;
  box-sizing: border-box;
}

.tl__dot--pending { border-color: #3b82f6; }
.tl__dot--done { border-color: #52a878; }
.tl__dot--transferred { border-color: #8b5cf6; }
.tl__dot--refunded { border-color: #9aa1aa; }

.tl__line {
  flex: 1;
  width: 4rpx;
  background: #d0d5dd;
  opacity: 0.9;
  margin-top: -2rpx;
}

.tl__cards {
  flex: 1;
  min-width: 0;
  padding-bottom: 36rpx;
}
