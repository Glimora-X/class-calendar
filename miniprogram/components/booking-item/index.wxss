.card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.08);
  overflow: hidden;
  color: #1b2430;
}

.card__accent {
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: #3b82f6;
}

.card.tone-primary .card__accent,
.card.tone-surface .card__accent {
  background: #3b82f6;
}

.card.tone-mint .card__accent {
  background: #34d399;
}

.card.tone-pro .card__accent {
  background: #8b5cf6;
}

.card.tone-warning .card__accent {
  background: #f59e0b;
}

.card__time {
  width: 72rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.card__time-start,
.card__time-end {
  font-size: 22rpx;
  color: #8b95a5;
  line-height: 1.2;
  font-weight: 500;
}

.card__time-sep {
  font-size: 16rpx;
  color: #c5cdd8;
  line-height: 1;
}

.card__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef2f7;
}

.card__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #3b82f6;
}

.card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1b2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.card__teacher {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 400;
  flex-shrink: 0;
}

.card__teacher.tone-primary,
.card__teacher.tone-surface {
  background: rgba(59, 130, 246, 0.1);
  color: #60a5fa;
}

.card__teacher.tone-mint {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
}

.card__teacher.tone-pro {
  background: rgba(139, 92, 246, 0.1);
  color: #a78bfa;
}

.card__teacher.tone-warning {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
}

.card__note-icon {
  font-size: 20rpx;
  color: #8b95a5;
  flex-shrink: 0;
}

.card__note {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #8b95a5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card__status {
  flex-shrink: 0;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  border: 1rpx solid transparent;
}

.card__status.status-pending {
  color: #60a5fa;
  background: rgba(59, 130, 246, 0.08);
  border-color: rgba(59, 130, 246, 0.2);
}

.card__status.status-done {
  color: #34d399;
  background: rgba(52, 211, 153, 0.1);
  border-color: rgba(52, 211, 153, 0.22);
}

.card__status.status-transferred {
  color: #a78bfa;
  background: rgba(139, 92, 246, 0.08);
  border-color: rgba(139, 92, 246, 0.2);
}

.card__status.status-refunded {
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.12);
  border-color: rgba(148, 163, 184, 0.28);
}
