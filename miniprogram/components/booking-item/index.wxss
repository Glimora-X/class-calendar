.card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 36, 48, 0.08);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: transparent;
}

.tone-surface {
  background: #fff;
  color: #1b2430;
}

.tone-surface::before {
  background: #3b82f6;
}

.tone-primary {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(59, 130, 246, 0.35);
}

.tone-mint {
  background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(52, 211, 153, 0.35);
}

.card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card__title {
  font-size: 30rpx;
  font-weight: 700;
}

.card__time {
  font-size: 24rpx;
  opacity: 0.85;
}

.card__meta {
  font-size: 22rpx;
  opacity: 0.7;
}

.tone-surface .card__time,
.tone-surface .card__meta {
  color: #8b95a5;
  opacity: 1;
}

.card__more {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  opacity: 0.55;
  padding-top: 4rpx;
}
