<view
  class="tbc tbc--{{status || 'pending'}} {{selecting ? 'tbc--selecting' : ''}} {{selected ? 'tbc--picked' : ''}}"
  bindtap="onTap"
>
  <view wx:if="{{selecting}}" class="tbc__check {{selected ? 'is-on' : ''}}">{{selected ? '✓' : ''}}</view>
  <view class="tbc__ribbon">{{statusLabel}}</view>
  <view class="tbc__row tbc__row--top">
    <text class="tbc__time">{{startTime}} — {{endTime}}</text>
  </view>
  <view class="tbc__row tbc__row--bottom">
    <text class="tbc__meta">{{metaText}}</text>
    <view class="tbc__teacher">
      <image
        wx:if="{{teacherAvatarUrl}}"
        class="tbc__avatar tbc__avatar--img"
        src="{{teacherAvatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="tbc__avatar">{{teacherInitial}}</view>
      <text class="tbc__teacher-name">{{teacherName}}</text>
    </view>
  </view>
</view>
