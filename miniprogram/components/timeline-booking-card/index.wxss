.tbc {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 152rpx;
  padding: 20rpx 22rpx;
  padding-right: 72rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16rpx;
}

/* 右上角斜向角标 */
.tbc__ribbon {
  position: absolute;
  top: 18rpx;
  right: -40rpx;
  z-index: 2;
  width: 140rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.04em;
  transform: rotate(45deg);
  box-shadow: 0 4rpx 10rpx rgba(27, 36, 48, 0.12);
  pointer-events: none;
}

.tbc__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tbc__time {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  flex: 1;
  min-width: 0;
}

.tbc__meta {
  flex: 1;
  min-width: 120rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tbc__teacher {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 45%;
}

.tbc__avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(29, 41, 57, 0.08);
  color: inherit;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
}

.tbc__teacher-name {
  font-size: 26rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— 四态 —— */
.tbc--pending {
  background: #f0f6ff;
  color: #1d2939;
}
.tbc--pending .tbc__time { color: #2563eb; }
.tbc--pending .tbc__ribbon { background: #3b82f6; }

.tbc--done {
  background: #f3f7f5;
  color: #34483d;
}
.tbc--done .tbc__time { color: #438a62; }
.tbc--done .tbc__ribbon { background: #52a878; }

.tbc--transferred {
  background: #f7f3ff;
  color: #49356b;
}
.tbc--transferred .tbc__time { color: #7c4ddb; }
.tbc--transferred .tbc__ribbon { background: #8b5cf6; }

.tbc--refunded {
  background: #f6f7f8;
  color: #667085;
}
.tbc--refunded .tbc__time { color: #7b8490; }
.tbc--refunded .tbc__ribbon { background: #9aa1aa; }
