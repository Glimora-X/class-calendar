.tbc {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  /* 贴合内容，避免 space-between 虚高；视觉目标约 88–96px */
  min-height: 0;
  padding: 24rpx 24rpx;
  padding-right: 56rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 12rpx;
}

/* 右上角斜向角标：相对原尺寸约缩小 30% */
.tbc__ribbon {
  position: absolute;
  top: 12rpx;
  right: -28rpx;
  z-index: 2;
  width: 98rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 16rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.04em;
  transform: rotate(45deg);
  box-shadow: 0 2rpx 8rpx rgba(27, 36, 48, 0.1);
  pointer-events: none;
}

.tbc__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tbc__time {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  flex: 1;
  min-width: 0;
}

.tbc__meta {
  flex: 1;
  min-width: 120rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #344054;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tbc__teacher {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 45%;
}

.tbc__avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(29, 41, 57, 0.08);
  color: inherit;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
  overflow: hidden;
}

.tbc__avatar--img {
  display: block;
  padding: 0;
  background: #e8eef6;
}

.tbc__teacher-name {
  font-size: 26rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— 四态 —— */
.tbc--pending {
  background: #f0f6ff;
  color: #1d2939;
}
.tbc--pending .tbc__time { color: #2563eb; }
.tbc--pending .tbc__ribbon { background: #3b82f6; }

.tbc--done {
  background: #f3f7f5;
  color: #34483d;
}
.tbc--done .tbc__time { color: #438a62; }
.tbc--done .tbc__ribbon { background: #52a878; }

.tbc--transferred {
  background: #f7f3ff;
  color: #49356b;
}
.tbc--transferred .tbc__time { color: #7c4ddb; }
.tbc--transferred .tbc__ribbon { background: #8b5cf6; }

.tbc--refunded {
  background: #f6f7f8;
  color: #667085;
}
.tbc--refunded .tbc__time { color: #7b8490; }
.tbc--refunded .tbc__ribbon { background: #9aa1aa; }

.tbc--missed {
  background: #fff8ef;
  color: #7a4e12;
}
.tbc--missed .tbc__time { color: #d97706; }
.tbc--missed .tbc__ribbon { background: #f59e0b; }

.tbc--selecting {
  padding-left: 72rpx;
}

.tbc--picked {
  box-shadow: inset 0 0 0 3rpx rgba(59, 130, 246, 0.28);
}

.tbc__check {
  position: absolute;
  left: 20rpx;
  top: 50%;
  z-index: 3;
  width: 40rpx;
  height: 40rpx;
  margin-top: -20rpx;
  border-radius: 50%;
  border: 3rpx solid #c5ccd6;
  background: #fff;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.tbc__check.is-on {
  border-color: #3b82f6;
  background: #3b82f6;
}
